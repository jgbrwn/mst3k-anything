# mst3k-anything configuration
# Copy to .env and fill in. All LLM access is OpenAI-compliant chat completions.

# --- LLM provider (any OpenAI-compliant API) ---------------------------
LLM_BASE_URL=https://hyper.charm.land/v1
LLM_API_KEY=changeme
# Vision-capable writer model (sees the frames)
LLM_MODEL=qwen3.8-flash
# Optional separate model for the understand/profile stage
LLM_MODEL_UNDERSTAND=

# --- pipeline tuning ----------------------------------------------------
# Minimum silence (s) that can host a riff
MIN_GAP=2.0
# Safety margin (s) kept at each end of a gap
GAP_MARGIN=0.35
# Words per second of riff delivery (drives the budget)
WORDS_PER_SECOND=2.6
# Fraction of offered gaps that get a riff (0..1)
RIFF_RATE=0.55
# Max seconds for a single riff
MAX_RIFF_SECONDS=9.0

# --- tools --------------------------------------------------------------
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
POCKET_TTS_BIN=/home/exedev/mst3k/tts-venv/bin/pocket-tts

# --- voice --------------------------------------------------------------
# wav file Pocket TTS clones for the solo snarker (optional; blank = built-in voice)
VOICE_SAMPLE=
# Semitone pitch shift applied after TTS to color the voice
VOICE_PITCH_SEMITONES=4.0

# --- output -------------------------------------------------------------
JOBS_DIR=/home/exedev/mst3k-anything/jobs
