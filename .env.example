# mst3k-anything configuration
# Copy to .env and fill in. The UI can override provider/model per submission.
# All LLM access uses OpenAI-compatible chat completions.

# === Providers ===========================================================

# --- Hyper (default picker entry) --------------------------------------
HYPER_BASE_URL=https://hyper.charm.land/v1
HYPER_API_KEY=<your-hyper-key>
HYPER_WRITER_MODEL=qwen3.8-flash

# --- Neuralwatt --------------------------------------------------------
NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1
NEURALWATT_API_KEY=<your-neuralwatt-key>
NEURALWATT_WRITER_MODEL=kimi-k3-fast

# --- OpenRouter --------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=<your-openrouter-key>
# The WebUI can discover/select a model. A CLI render needs a model here.
OPENROUTER_WRITER_MODEL=

# === Optional process/job defaults ======================================
# These are useful for direct CLI runs or service-wide defaults. The WebUI
# stores per-job choices in SQLite and passes them to the child process.
# MST3K_PROVIDER=hyper
# MST3K_MODEL=qwen3.8-flash
# MST3K_JUDGE_PROVIDER=
# MST3K_JUDGE_MODEL=
# MST3K_RIFF_DENSITY_BIAS=2       # 0 Sparse ... 4 Relentless

# Reasoning controls are not universal. Set this only when the selected
# provider/model documents the OpenAI-compatible field.
# Empty/malformed structured responses already retry for every provider.
# MST3K_REASONING_EFFORT=low

# === Supported pipeline overrides ========================================
# TARGET_RIFF_COUNT=6             # optional hard writing cap
# CONTEXT_RADIUS_SEC=18.0
# SHORT_CLIP_LEAD_RATIO=0.1
# MIN_RIFF_SPACE_SEC=2.5
# MAX_RIFFS=400
# RIFF_GAIN=1.4
# Custom voice: local consented WAV or a PocketTTS .safetensors state.
# A WAV is exported once to ~/.cache/mst3k-anything/voices/ on first CLI render.
# VOICE_REF=/absolute/path/to/voice.wav
# VOICE_RATE=1.0                  # global multiplier; <1 is slower/less bright
# VOICE_PITCH=0.0                 # global semitone offset; negative is lower

# Paths, ffmpeg/yt-dlp binaries, density defaults, and most timing defaults
# are currently defined in src/mst3k/config.py rather than read from .env.
