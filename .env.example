# mst3k-anything configuration
# Copy to .env and fill in. All LLM access is OpenAI-compliant chat completions.

# === Per-provider API configuration (the picker) ========================
# The UI lets you pick among these providers per job. Each has its own
# trio of (base URL, API key, default model).

# --- Hyper (default writer) --------------------------------------------
HYPER_BASE_URL=https://hyper.charm.land/v1
HYPER_API_KEY=<your-hyper-key>
HYPER_WRITER_MODEL=qwen3.8-flash

# --- Neuralwatt --------------------------------------------------------
NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1
NEURALWATT_API_KEY=<your-neuralwatt-key>
NEURALWATT_WRITER_MODEL=kimi-k3-fast

# --- OpenRouter --------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=<your-openrouter-key>
# Leave blank to have the UI present the list. High-context multimodal
# models are tagged "free" by OpenRouter when applicable.
OPENROUTER_WRITER_MODEL=

# === Optional per-role judge override ===================================
# The judge (QA pass) can run on a different provider/model combination.
# Leave both unset to use the same provider/model the writer uses.
JUDGE_PROVIDER=
JUDGE_MODEL=

# === Pipeline tuning =====================================================
# Minimum silence (s) that can host a riff
MIN_GAP=0.8
# Safety margin (s) kept at each end of a gap
GAP_MARGIN=0.2
# Words per second of riff delivery (drives the budget)
WORDS_PER_SECOND=2.0
# Number of riffs to target per video (the +2x pool is offered to the writer)
TARGET_RIFF_COUNT=6
# Maximum seconds for a single riff
MAX_RIFF_SECONDS=9.0
# Don't riff the opening / lead-in seconds
LEAD_IN_SEC=3.0
# Fraction of a candidate window that can be partially spoken before reject
MAX_SPEECH_FRAC=0.3
# How loud relative to the median a "quiet moment" can be (-8 = strict)
MOMENT_RELAX_DB=3.0

# === Tools ===============================================================
YT_DLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# === Output ===============================================================
JOBS_DIR=./jobs

# === Voice ================================================================
# Optional wav file Pocket TTS clones for the solo snarker (blank = built-in)
VOICE_SAMPLE=
# Semitone pitch shift applied after TTS
VOICE_PITCH_SEMITONES=4.0
